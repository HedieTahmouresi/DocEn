# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.so
*.pt
*.pth

# Virtual environments
# NOTE: these are anchored to the repo root on purpose. An unanchored `env/`
# also matches `configs/env/`, which is how the environment profiles ended up
# silently untracked (and every `--env colab_t4` run silently fell back to CPU).
/venv/
/env/
/.env/
/.venv/

# Local paths override
paths.yaml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data (too large for git)
*.zip
data/clean_scans/
data/backgrounds/
data/real_photos/
data/frozen/
!data/splits/
!data/.gitkeep

# Outputs and runs
outputs/checkpoints/
outputs/logs/
runs/
!outputs/figures/
!.gitkeep

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# NOT ignored, deliberately: .agents/, AGENTS.md and GEMINI.md are committed.
# 06-workflow/git-workflow.md: ".agents/state/ is version-controlled deliberately. It is
# the handoff mechanism: a future agent reads STATUS.md at main and knows where the
# project is." An earlier `.agents/` line here did nothing to the already-tracked files
# but silently refused every *new* one — the same failure mode as the unanchored `env/`
# pattern that swallowed configs/env/ and turned a GPU run into a CPU run.